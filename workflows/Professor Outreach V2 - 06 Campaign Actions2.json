    {
      "parameters": {
        "httpMethod": "POST",
        "path": "v2-recipients-select",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f33ebaf1-3d0b-4f5f-aaa0-fcaaaf5abf42",
      "name": "Select Recipients Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -960,
        208
      ],
      "webhookId": "v2-recipients-select"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst ownerId = String(headers['x-owner-id'] ?? $env.OUTREACH_DEFAULT_OWNER_ID ?? '').trim();\nconst campaignId = String(body.campaign_id ?? '').trim();\nconst recipientIds = Array.isArray(body.recipient_ids) ? body.recipient_ids.map(String) : [];\nif (!/^[0-9a-f-]{36}$/i.test(ownerId)) throw new Error('OWNER_ID_INVALID');\nif (!/^[0-9a-f-]{36}$/i.test(campaignId)) throw new Error('CAMPAIGN_ID_INVALID');\nif (!recipientIds.length || recipientIds.length > 100) throw new Error('RECIPIENT_IDS_INVALID');\nfor (const id of recipientIds) if (!/^[0-9a-f-]{36}$/i.test(id)) throw new Error('RECIPIENT_ID_INVALID');\nreturn [{ json: { owner_id: ownerId, campaign_id: campaignId, recipient_ids: recipientIds, requested_count: recipientIds.length } }];"
      },
      "id": "1f494009-001e-43c7-8117-0fa5706b5bbb",
      "name": "Validate Select Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        208
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (SELECT r.id FROM recipients r JOIN campaigns cp ON cp.id = r.campaign_id JOIN candidates c ON c.id = cp.candidate_id WHERE r.campaign_id = $1 AND c.owner_id = $2 AND r.id = ANY($3::uuid[]) AND r.status = 'DISCOVERED' FOR UPDATE OF r) UPDATE recipients r SET status = 'SELECTED' FROM target t WHERE r.id = t.id RETURNING r.id AS recipient_id, r.status;",
        "options": {
          "queryReplacement": "={{ [$json.campaign_id, $json.owner_id, $json.recipient_ids] }}"
        }
      },
      "id": "12c6c123-fe9f-405b-88fb-64fc18eac3d2",
      "name": "CONFIGURE - Atomically Select Recipients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -480,
        208
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const requested = $('Validate Select Request').item.json.requested_count;\nconst selectedIds = $input.all().map(i => i.json).filter(j => j && j.recipient_id).map(j => j.recipient_id);\nreturn [{ json: { requested_count: requested, selected_count: selectedIds.length, selected_recipient_ids: selectedIds } }];"
      },
      "id": "ca2a8ddd-8afe-4617-9b9d-ab9d6570dded",
      "name": "Build Select Response",
      "type": "n8n-nodes-base.code",
