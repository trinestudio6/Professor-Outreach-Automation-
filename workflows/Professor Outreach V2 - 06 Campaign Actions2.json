      },
      "id": "bdb01a44-a5a5-4120-86a4-7d75b031bf19",
      "name": "Activate Campaign Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -960,
        -48
      ],
      "webhookId": "v2-campaigns-activate"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst ownerId = String(headers['x-owner-id'] ?? $env.OUTREACH_DEFAULT_OWNER_ID ?? '').trim();\nconst campaignId = String(body.campaign_id ?? '').trim();\nif (!/^[0-9a-f-]{36}$/i.test(ownerId)) throw new Error('OWNER_ID_INVALID');\nif (!/^[0-9a-f-]{36}$/i.test(campaignId)) throw new Error('CAMPAIGN_ID_INVALID');\nreturn [{ json: { owner_id: ownerId, campaign_id: campaignId } }];"
      },
      "id": "94a97477-38dc-4cad-a8ad-2c9e1e8f82b3",
      "name": "Validate Activate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        -48
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (SELECT cp.id FROM campaigns cp JOIN candidates c ON c.id = cp.candidate_id WHERE cp.id = $1 AND c.owner_id = $2 AND cp.status IN ('DRAFT','PAUSED') FOR UPDATE OF cp) UPDATE campaigns cp SET status = 'ACTIVE' FROM target t WHERE cp.id = t.id RETURNING cp.id AS campaign_id, cp.status;",
        "options": {
          "queryReplacement": "={{ [$json.campaign_id, $json.owner_id] }}"
        }
      },
      "id": "3518278f-3cdc-4174-90b5-65a686ef0265",
      "name": "CONFIGURE - Atomically Activate Campaign",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -480,
        -48
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.campaign_id }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "97c1788d-4a73-416b-81e4-8bc4c647283a",
      "name": "Was Activated?",
