    {
      "parameters": {
        "jsCode": "function uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst body = $json.body ?? {};\nconst fields = body.data?.fields ?? [];\nconst byKey = Object.fromEntries(fields.map(f => [f.key, f]));\nconst eventId = String(body.eventId ?? body.event_id ?? '').trim();\nconst name = String(byKey.question_QBKQqG?.value ?? body.full_name ?? '').trim();\nconst email = String(byKey.question_9JqKYV?.value ?? body.email ?? '').trim().toLowerCase();\n\n// TODO: no consent field exists on the Tally form yet — replace\n// \"question_REPLACE_ME\" with the real key once you've added one and\n// resubmitted a test response.\nconst consent = byKey.question_REPLACE_ME?.value ?? body.consent;\n\nconst cv = (byKey.question_exqXGk?.value ?? body.cv ?? [])[0];\nif (!eventId || !name || !email || !cv?.url) throw new Error('INTAKE_REQUIRED_FIELD_MISSING');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('INTAKE_EMAIL_INVALID');\n//if (consent !== true && String(consent).toLowerCase() !== 'yes') throw new Error('INTAKE_CONSENT_REQUIRED');\nif (!/^https:\\/\\/storage\\.tally\\.so\\//.test(cv.url)) throw new Error('INTAKE_FILE_HOST_REJECTED');\nif (Number(cv.size ?? 0) > 10 * 1024 * 1024) throw new Error('INTAKE_FILE_TOO_LARGE');\nconst candidateId = uuidv4();\nreturn [{ json: { event_id: eventId, candidate_id: candidateId, owner_id: $env.OUTREACH_DEFAULT_OWNER_ID, full_name: name, email, consent_at: new Date().toISOString(), cv_url: cv.url, cv_file_name: String(cv.name ?? cv.fileName ?? 'base-cv.pdf') } }];\n\n"
      },
