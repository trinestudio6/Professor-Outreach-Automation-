      "parameters": {
        "jsCode": "const input = $('Validate and Normalize Intake').item.json;\nconst file = $binary?.data;\nif (!file) throw new Error('CV_BINARY_MISSING');\nif (String(file.mimeType || '').toLowerCase() !== 'application/pdf') throw new Error('ONLY_PDF_CV_SUPPORTED');\nif (Number(file.fileSize || 0) > 10 * 1024 * 1024) throw new Error('CV_FILE_TOO_LARGE');\nreturn [{ json: input, binary: { data: { ...file, fileName: `base-cv-${input.candidate_id}.pdf`, mimeType: 'application/pdf' } } }];"
      },
