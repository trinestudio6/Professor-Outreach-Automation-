      },
      "id": "ab3e67e2-5196-4bf8-acdf-85132d647d4f",
      "name": "Approve Recipient Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        224
