    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst ownerId = String($json.verified_owner_id ?? '').trim();\nconst recipientId = String(body.recipient_id ?? '').trim();\nconst reason = String(body.reason ?? '').trim().slice(0, 500);\nif (!/^[0-9a-f-]{36}$/i.test(ownerId)) throw new Error('OWNER_ID_INVALID');\nif (!/^[0-9a-f-]{36}$/i.test(recipientId)) throw new Error('RECIPIENT_ID_INVALID');\nreturn [{ json: { owner_id: ownerId, recipient_id: recipientId, reason } }];"
      },
      "id": "c27af620-637b-4978-b5d6-c71ae7f21c0e",
      "name": "Validate Reject Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        464
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (SELECT r.id FROM recipients r JOIN campaigns cp ON cp.id = r.campaign_id JOIN candidates c ON c.id = cp.candidate_id WHERE r.id = $1 AND c.owner_id = $2 AND r.status = 'REVIEW_REQUIRED' FOR UPDATE OF r) UPDATE recipients r SET status = 'DO_NOT_CONTACT', last_error_code = 'REJECTED_BY_REVIEWER', last_error_message = $3 FROM target t WHERE r.id = t.id RETURNING r.id AS recipient_id, r.campaign_id, r.status;",
        "options": {
          "queryReplacement": "={{ [$json.recipient_id, $json.owner_id, $json.reason] }}"
        }
