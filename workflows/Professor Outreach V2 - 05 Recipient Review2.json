    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst user = res.body ?? {};\nif (res.statusCode !== 200 || !/^[0-9a-f-]{36}$/i.test(String(user.id ?? ''))) {\n  throw new Error('AUTH_INVALID');\n}\nconst original = $('List Reviews Webhook').first();\nconst out = { json: { ...original.json, verified_owner_id: user.id } };\nif (original.binary) out.binary = original.binary;\nreturn [out];"
