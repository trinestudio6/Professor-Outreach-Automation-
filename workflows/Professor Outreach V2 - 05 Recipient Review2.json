    {
      "parameters": {
        "jsCode": "const query = $json.query ?? {};\nconst headers = $json.headers ?? {};\nconst ownerId = String($json.verified_owner_id ?? '').trim();\nconst candidateId = String(query.candidate_id ?? '').trim();\nconst campaignId = String(query.campaign_id ?? '').trim();\nif (!/^[0-9a-f-]{36}$/i.test(ownerId)) throw new Error('OWNER_ID_INVALID');\nif (candidateId && !/^[0-9a-f-]{36}$/i.test(candidateId)) throw new Error('CANDIDATE_ID_INVALID');\nif (campaignId && !/^[0-9a-f-]{36}$/i.test(campaignId)) throw new Error('CAMPAIGN_ID_INVALID');\nif (!candidateId && !campaignId) throw new Error('SCOPE_REQUIRED');\nreturn [{ json: { owner_id: ownerId, candidate_id: candidateId || null, campaign_id: campaignId || null } }];"
      },
      "id": "2f495b45-04f6-49fc-b72f-f78d40f94099",
      "name": "Validate List Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT r.id AS recipient_id, r.campaign_id, r.professor_name, r.professor_email, r.university, r.canonical_profile_url, r.research_interest, r.evidence_json, r.approved_subject AS draft_subject, r.approved_html_body AS draft_html_body, r.approved_cv_object_key AS draft_cv_object_key, r.claimed_at AS enriched_at FROM recipients r JOIN campaigns cp ON cp.id = r.campaign_id JOIN candidates c ON c.id = cp.candidate_id WHERE r.status = 'REVIEW_REQUIRED' AND c.owner_id = $1 AND ($2::uuid IS NULL OR r.campaign_id = $2::uuid) AND ($3::uuid IS NULL OR cp.candidate_id = $3::uuid) ORDER BY r.claimed_at ASC NULLS LAST, r.id;",
        "options": {
          "queryReplacement": "={{ [$json.owner_id, $json.campaign_id, $json.candidate_id] }}"
        }
      },
      "id": "2d070f12-432c-466d-bad2-30f0823a833c",
      "name": "CONFIGURE - Query Pending Reviews",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        960,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const recipients = $input.all().map(i => i.json);\nreturn [{ json: { count: recipients.length, recipients } }];"
      },
