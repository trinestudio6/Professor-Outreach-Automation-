    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\nconst headers = $json.headers ?? {};\nconst ownerId = String($json.verified_owner_id ?? '').trim();\nconst recipientId = String(body.recipient_id ?? '').trim();\nif (!/^[0-9a-f-]{36}$/i.test(ownerId)) throw new Error('OWNER_ID_INVALID');\nif (!/^[0-9a-f-]{36}$/i.test(recipientId)) throw new Error('RECIPIENT_ID_INVALID');\nlet editedSubject = body.edited_subject != null ? String(body.edited_subject) : '';\nlet editedHtmlBody = body.edited_html_body != null ? String(body.edited_html_body) : '';\nif (editedSubject && (/[\\r\\n]/.test(editedSubject) || editedSubject.length > 160)) throw new Error('EDITED_SUBJECT_INVALID');\nif (editedHtmlBody && (!/^<p>[\\s\\S]*<\\/p>$/.test(editedHtmlBody.trim()) || /<(script|iframe|object|style)\\b/i.test(editedHtmlBody))) throw new Error('EDITED_HTML_BODY_INVALID');\nreturn [{ json: { owner_id: ownerId, recipient_id: recipientId, edited_subject: editedSubject, edited_html_body: editedHtmlBody } }];"
      },
      "id": "07274b4f-f1f9-4197-926b-5c60a9974a6f",
      "name": "Validate Approve Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        224
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH target AS (SELECT r.id FROM recipients r JOIN campaigns cp ON cp.id = r.campaign_id JOIN candidates c ON c.id = cp.candidate_id WHERE r.id = $1 AND c.owner_id = $2 AND r.status = 'REVIEW_REQUIRED' FOR UPDATE OF r) UPDATE recipients r SET status = 'APPROVED', approved_subject = COALESCE(NULLIF($3, ''), r.approved_subject), approved_html_body = COALESCE(NULLIF($4, ''), r.approved_html_body) FROM target t WHERE r.id = t.id RETURNING r.id AS recipient_id, r.campaign_id, r.status, r.approved_subject, r.approved_html_body;",
        "options": {
          "queryReplacement": "={{ [$json.recipient_id, $json.owner_id, $json.edited_subject, $json.edited_html_body] }}"
        }
      },
      "id": "8c0ad48d-e868-4549-9e96-ee329dccdc56",
      "name": "CONFIGURE - Atomically Approve Recipient",
