        "query": "INSERT INTO candidates(id,owner_id,full_name,email,consent_at,base_cv_object_key,base_cv_file_name,base_cv_mime_type,status) VALUES ($1,$2,$3,$4,$5,$6,$7,'application/pdf','RECEIVED') RETURNING id AS candidate_id,status;",
        "options": {
