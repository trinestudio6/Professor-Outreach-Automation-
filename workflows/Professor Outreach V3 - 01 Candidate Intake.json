    },
    {
      "parameters": {
        "jsCode": "const input = $('Validate and Normalize Intake').item.json;\nconst file = $binary?.data || $binary?.cv;\nif (!file) throw new Error('CV_BINARY_MISSING');\nif (String(file.mimeType || '').toLowerCase() !== 'application/pdf') throw new Error('ONLY_PDF_CV_SUPPORTED');\n\nreturn [{ \n  json: input, \n  binary: { \n    data: { \n      ...file, \n      fileName: 'base-cv-' + input.candidate_id + '.pdf', \n      mimeType: 'application/pdf' \n    } \n  } \n}];"
      },
      "id": "779a4bfd-0778-4bec-a262-f94546534f6e",
