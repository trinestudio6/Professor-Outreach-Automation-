    {
      "parameters": {
        "jsCode": "function uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = (Math.random() * 16) | 0;\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n}\n\nconst body = $json.body ?? {};\nlet name = String(body.full_name ?? '').trim();\nif (!name && body.name) name = String(body.name).trim();\n\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst domain = String(body.domain ?? '').trim();\n\nif (!name || !email) throw new Error('INTAKE_REQUIRED_FIELD_MISSING');\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('INTAKE_EMAIL_INVALID');\n\nconst candidateId = uuidv4();\n\nreturn [{ \n  json: { \n    event_id: candidateId, \n    candidate_id: candidateId, \n    owner_id: $json.verified_owner_id, \n    full_name: name, \n    email: email,\n    domain: domain,\n    consent_at: new Date().toISOString(), \n    cv_file_name: 'base-cv.pdf' \n  } \n}];"
      },
      "id": "d4a0d231-ec2e-4471-a84e-877a4f68669f",
      "name": "Validate and Normalize Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        112
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS ( INSERT INTO webhook_events(provider,event_id,status) VALUES ('tally',$1,'RECEIVED') ON CONFLICT (provider,event_id) DO NOTHING RETURNING event_id ) SELECT EXISTS (SELECT 1 FROM inserted) AS is_new, $1::text AS event_id;",
        "options": {
          "queryReplacement": "={{ [$json.event_id] }}"
        }
      },
      "id": "cfde8825-eb90-487a-ba73-ab7cae4d3644",
